{
    "name": "libremap/librenms-plugin",
    "description": "AGG-first interactive network topology for LibreNMS",
    "type": "library",
    "keywords": [
        "librenms",
        "network",
        "topology",
        "monitoring",
        "network-map",
        "laravel"
    ],
    "homepage": "https://github.com/Drakelid/librenms-map",
    "license": "MIT",
    "authors": [
        {
            "name": "Fredrik Drakelid",
            "email": "fredrik@drakelid.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Drakelid/librenms-map/issues",
        "source": "https://github.com/Drakelid/librenms-map"
    },
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/validation": "^12.0",
        "illuminate/view": "^12.0",
        "symfony/http-foundation": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "LibreMap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LibreMap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LibreMap\\LibreMapServiceProvider"
            ]
        }
    }
}
